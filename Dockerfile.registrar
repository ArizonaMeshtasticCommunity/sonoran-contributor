# syntax=docker/dockerfile:1

# rf-registrar: the broker logins of RF stations, for the Discord bot.
# See docs/REGISTRAR.md. It runs on the broker's host, not at a station,
# so it is built for amd64 and arm64 only.
#
# The lock stage is the same as the agent's. See Dockerfile.
FROM --platform=$BUILDPLATFORM ghcr.io/astral-sh/uv:0.10.1@sha256:452e02b117acd2d4eb3ba81a607bed9733b101b6c49492e352b1973463389012 AS lock
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN ["/uv", "export", "--frozen", "--no-dev", "--no-emit-project", "--extra", "registrar", \
     "--format", "requirements-txt", "-o", "/requirements.txt"]

FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY --from=lock /requirements.txt /tmp/requirements.txt
RUN pip install --require-hashes -r /tmp/requirements.txt && rm /tmp/requirements.txt

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps . && rm -rf /app/src

# Its records, in SQLite. Mount a volume here.
RUN useradd --system --no-create-home --uid 10001 rf-registrar \
    && mkdir /data && chown rf-registrar /data
USER rf-registrar
VOLUME /data
EXPOSE 8080

HEALTHCHECK --interval=60s --timeout=5s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/v1/health', timeout=4)"]

ENTRYPOINT ["rf-registrar"]
