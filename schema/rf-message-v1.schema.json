{
  "$defs": {
    "Batch": {
      "description": "A batch of observations of one kind, from one station.",
      "properties": {
        "kind": {
          "enum": [
            "adsb",
            "uat",
            "aprs",
            "sonde",
            "ism"
          ],
          "title": "Kind",
          "type": "string"
        },
        "obs": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 100,
          "title": "Obs",
          "type": "array"
        },
        "sent": {
          "format": "date-time",
          "title": "Sent",
          "type": "string"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "kind",
        "sent",
        "obs"
      ],
      "title": "Batch",
      "type": "object"
    },
    "Counts": {
      "description": "What the agent did since its last heartbeat.",
      "properties": {
        "dropped": {
          "default": 0,
          "minimum": 0,
          "title": "Dropped",
          "type": "integer"
        },
        "heard": {
          "default": 0,
          "minimum": 0,
          "title": "Heard",
          "type": "integer"
        },
        "sent": {
          "default": 0,
          "minimum": 0,
          "title": "Sent",
          "type": "integer"
        }
      },
      "title": "Counts",
      "type": "object"
    },
    "Observation": {
      "description": "One thing heard, at one moment, by one station.",
      "properties": {
        "alt_m": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": -500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt M"
        },
        "alt_ref": {
          "anyOf": [
            {
              "enum": [
                "baro",
                "geom"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Ref"
        },
        "direct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direct"
        },
        "gs_kn": {
          "anyOf": [
            {
              "maximum": 2000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gs Kn"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        },
        "precision_m": {
          "anyOf": [
            {
              "maximum": 500000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision M"
        },
        "raw": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "rssi_db": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": -200,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rssi Db"
        },
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        },
        "track_deg": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Deg"
        },
        "via": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via"
        }
      },
      "required": [
        "id",
        "t",
        "lat",
        "lon"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Spectrum": {
      "description": "One minute of the 900 MHz band from one station, on `rf/v1/<station>/spectrum`.\n\nBin `i` covers `f_start_hz + i * bin_hz` to the next bin. Per bin: the\nmedian, the 95th percentile and the peak level over the minute's\nsweeps, and `busy`, the share of sweeps in percent in which the bin\nstood more than 6 dB above its own median. The four arrays have one\nentry per bin. Levels compare one station with itself over time,\nnever two stations (design 3.5).",
      "properties": {
        "bin_hz": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Bin Hz",
          "type": "integer"
        },
        "busy": {
          "items": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Busy",
          "type": "array"
        },
        "f_start_hz": {
          "maximum": 6000000000,
          "minimum": 0,
          "title": "F Start Hz",
          "type": "integer"
        },
        "gain_db": {
          "maximum": 100,
          "minimum": -10,
          "title": "Gain Db",
          "type": "number"
        },
        "kind": {
          "const": "spectrum",
          "title": "Kind",
          "type": "string"
        },
        "p50": {
          "items": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": -2000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "P50",
          "type": "array"
        },
        "p95": {
          "items": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": -2000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "P95",
          "type": "array"
        },
        "peak": {
          "items": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": -2000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Peak",
          "type": "array"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "sweeps": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Sweeps",
          "type": "integer"
        },
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "kind",
        "t",
        "f_start_hz",
        "bin_hz",
        "sweeps",
        "gain_db",
        "p50",
        "p95",
        "peak",
        "busy"
      ],
      "title": "Spectrum",
      "type": "object"
    },
    "Status": {
      "description": "The heartbeat, published retained on `rf/v1/<station>/status`.",
      "properties": {
        "agent_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Version"
        },
        "counts": {
          "$ref": "#/$defs/Counts",
          "default": {
            "dropped": 0,
            "heard": 0,
            "sent": 0
          }
        },
        "kinds": {
          "default": [],
          "items": {
            "enum": [
              "adsb",
              "uat",
              "aprs",
              "sonde",
              "ism"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "mesh_node": {
          "anyOf": [
            {
              "pattern": "^![0-9a-f]{8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mesh Node"
        },
        "precision_m": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision M"
        },
        "sent": {
          "format": "date-time",
          "title": "Sent",
          "type": "string"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "sent"
      ],
      "title": "Status",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Published by rf-agent. Observations go to rf/v1/<station>/<kind>, the heartbeat to rf/v1/<station>/status, retained, and a minute of the 900 MHz band to rf/v1/<station>/spectrum. See docs/design/rf-map.md section 4. Generated from sonoran/rf/schema.py.",
  "else": {
    "else": {
      "$ref": "#/$defs/Status"
    },
    "if": {
      "properties": {
        "kind": {
          "const": "spectrum"
        }
      },
      "required": [
        "kind"
      ]
    },
    "then": {
      "$ref": "#/$defs/Spectrum"
    }
  },
  "if": {
    "required": [
      "obs"
    ]
  },
  "then": {
    "$ref": "#/$defs/Batch"
  },
  "title": "rf-agent message, version 1"
}
