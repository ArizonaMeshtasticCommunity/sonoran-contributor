{
  "$defs": {
    "Batch": {
      "description": "A batch of observations of one kind, from one station.",
      "properties": {
        "kind": {
          "enum": [
            "adsb",
            "uat",
            "aprs",
            "sonde",
            "ism"
          ],
          "title": "Kind",
          "type": "string"
        },
        "obs": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 100,
          "title": "Obs",
          "type": "array"
        },
        "sent": {
          "format": "date-time",
          "title": "Sent",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "kind",
        "sent",
        "obs"
      ],
      "title": "Batch",
      "type": "object"
    },
    "Counts": {
      "description": "What the agent did since its last heartbeat.",
      "properties": {
        "dropped": {
          "default": 0,
          "minimum": 0,
          "title": "Dropped",
          "type": "integer"
        },
        "heard": {
          "default": 0,
          "minimum": 0,
          "title": "Heard",
          "type": "integer"
        },
        "sent": {
          "default": 0,
          "minimum": 0,
          "title": "Sent",
          "type": "integer"
        }
      },
      "title": "Counts",
      "type": "object"
    },
    "Custom": {
      "description": "A batch from a member's own mod, on `rf/v1/<station>/custom` (#324).\n\n`mod` names the program within the station. Sonoran stores each point\nunder the station and the mod, so a mod can never post as another\nstation, another mod, or a built-in kind. It gets no more trust than\na built-in decoder, and is shown as unverified.",
      "properties": {
        "kind": {
          "const": "custom",
          "title": "Kind",
          "type": "string"
        },
        "mod": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
          "title": "Mod",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/CustomPoint"
          },
          "maxItems": 100,
          "title": "Points",
          "type": "array"
        },
        "sent": {
          "format": "date-time",
          "title": "Sent",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "kind",
        "mod",
        "sent",
        "points"
      ],
      "title": "Custom",
      "type": "object"
    },
    "CustomPoint": {
      "description": "One thing a member's mod heard (#324, section 6).\n\nA position is optional. With `heard_here`, the point is drawn at the\nstation's own rounded position, and any position it sends is not\nused. With neither, it is listed in the table and never drawn.",
      "properties": {
        "heard_here": {
          "default": false,
          "title": "Heard Here",
          "type": "boolean"
        },
        "id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        },
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "id",
        "t"
      ],
      "title": "CustomPoint",
      "type": "object"
    },
    "Observation": {
      "description": "One thing heard, at one moment, by one station.",
      "properties": {
        "alt_m": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": -500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt M"
        },
        "alt_ref": {
          "anyOf": [
            {
              "enum": [
                "baro",
                "geom"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Ref"
        },
        "direct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direct"
        },
        "gs_kn": {
          "anyOf": [
            {
              "maximum": 2000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gs Kn"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        },
        "precision_m": {
          "anyOf": [
            {
              "maximum": 500000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision M"
        },
        "raw": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "rssi_db": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": -200,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rssi Db"
        },
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        },
        "track_deg": {
          "anyOf": [
            {
              "maximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Deg"
        },
        "via": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via"
        }
      },
      "required": [
        "id",
        "t",
        "lat",
        "lon"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Registry": {
      "description": "A location's entry in the registry, on `rf/v1/<station>/registry`.\n\nThe registrar publishes it, retained, when a location or its tokens\nchange (#305). The broker lets nobody else publish to this topic, so\na station cannot claim a name or an owner. `sources` are the\nsources that hold a login now. An empty retained message removes\nthe entry.",
      "properties": {
        "display_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "sent": {
          "format": "date-time",
          "title": "Sent",
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Sources",
          "type": "array"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "sent",
        "display_name"
      ],
      "title": "Registry",
      "type": "object"
    },
    "Spectrum": {
      "description": "One minute of one swept range from one station, on `rf/v1/<station>/spectrum`.\n\nA station may sweep any range it chooses, and more than one: with\ntwo dongles, or one that takes turns (#324). Each range sends its\nown minutes. A range is known by its source, `f_start_hz`, `bin_hz`\nand number of bins; `name` is an optional label the station gives it.\n\nBin `i` covers `f_start_hz + i * bin_hz` to the next bin. Per bin: the\nmedian, the 95th percentile and the peak level over the minute's\nsweeps, and `busy`, the share of sweeps in percent in which the bin\nstood more than 6 dB above its own median. The four arrays have one\nentry per bin. Levels compare one station with itself over time,\nnever two stations (design 3.5).",
      "properties": {
        "bin_hz": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Bin Hz",
          "type": "integer"
        },
        "busy": {
          "items": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Busy",
          "type": "array"
        },
        "f_start_hz": {
          "maximum": 6000000000,
          "minimum": 0,
          "title": "F Start Hz",
          "type": "integer"
        },
        "gain_db": {
          "maximum": 100,
          "minimum": -10,
          "title": "Gain Db",
          "type": "number"
        },
        "kind": {
          "const": "spectrum",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "p50": {
          "items": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": -2000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "P50",
          "type": "array"
        },
        "p95": {
          "items": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": -2000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "P95",
          "type": "array"
        },
        "peak": {
          "items": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": -2000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Peak",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "sweeps": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Sweeps",
          "type": "integer"
        },
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "kind",
        "t",
        "f_start_hz",
        "bin_hz",
        "sweeps",
        "gain_db",
        "p50",
        "p95",
        "peak",
        "busy"
      ],
      "title": "Spectrum",
      "type": "object"
    },
    "Status": {
      "description": "The heartbeat, published retained.\n\nAn agent with a `source` publishes it on\n`rf/v1/<station>/status/<source>`, so the sources of one location do\nnot overwrite each other's heartbeat. An agent without one publishes\nit on `rf/v1/<station>/status`.",
      "properties": {
        "agent_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Version"
        },
        "counts": {
          "$ref": "#/$defs/Counts",
          "default": {
            "dropped": 0,
            "heard": 0,
            "sent": 0
          }
        },
        "kinds": {
          "default": [],
          "items": {
            "enum": [
              "adsb",
              "uat",
              "aprs",
              "sonde",
              "ism"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "mesh_node": {
          "anyOf": [
            {
              "pattern": "^![0-9a-f]{8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mesh Node"
        },
        "precision_m": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision M"
        },
        "sent": {
          "format": "date-time",
          "title": "Sent",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "station": {
          "pattern": "^[a-z0-9-]{3,32}$",
          "title": "Station",
          "type": "string"
        },
        "sweeps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Sweep"
          },
          "maxItems": 8,
          "title": "Sweeps",
          "type": "array"
        },
        "v": {
          "const": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "station",
        "sent"
      ],
      "title": "Status",
      "type": "object"
    },
    "Sweep": {
      "description": "What one sweeper of a station runs, as the station reports it (#324).\n\nThis is a claim, shown as \"reported by the station\". Nothing is ever\nrun from it, and it never changes how a station's data is trusted.\n`command` is the exact command line the sweeper runs, for a reader\nwho wants to repeat it. `dwell_s` is set when one dongle takes turns\nbetween ranges: it sweeps this range `dwell_s` seconds at a time.",
      "properties": {
        "bin_hz": {
          "maximum": 10000000,
          "minimum": 1,
          "title": "Bin Hz",
          "type": "integer"
        },
        "command": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "dwell_s": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dwell S"
        },
        "f_end_hz": {
          "maximum": 6000000000,
          "minimum": 0,
          "title": "F End Hz",
          "type": "integer"
        },
        "f_start_hz": {
          "maximum": 6000000000,
          "minimum": 0,
          "title": "F Start Hz",
          "type": "integer"
        },
        "gain_db": {
          "maximum": 100,
          "minimum": -10,
          "title": "Gain Db",
          "type": "number"
        },
        "interval_s": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval S"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "ppm": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": -1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ppm"
        },
        "tool": {
          "pattern": "^[a-z0-9_.-]{1,32}$",
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "required": [
        "tool",
        "f_start_hz",
        "f_end_hz",
        "bin_hz",
        "gain_db"
      ],
      "title": "Sweep",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Published by rf-agent. Observations go to rf/v1/<station>/<kind>, the heartbeat to rf/v1/<station>/status/<source> (or rf/v1/<station>/status without a source), retained, and a minute of a swept range to rf/v1/<station>/spectrum, and a member's mod's points to rf/v1/<station>/custom. The registrar alone publishes the Registry to rf/v1/<station>/registry, retained. See docs/design/rf-map.md section 4. Generated from sonoran/rf/schema.py.",
  "else": {
    "else": {
      "else": {
        "else": {
          "$ref": "#/$defs/Status"
        },
        "if": {
          "required": [
            "display_name"
          ]
        },
        "then": {
          "$ref": "#/$defs/Registry"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "custom"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "$ref": "#/$defs/Custom"
      }
    },
    "if": {
      "properties": {
        "kind": {
          "const": "spectrum"
        }
      },
      "required": [
        "kind"
      ]
    },
    "then": {
      "$ref": "#/$defs/Spectrum"
    }
  },
  "if": {
    "required": [
      "obs"
    ]
  },
  "then": {
    "$ref": "#/$defs/Batch"
  },
  "title": "rf-agent message, version 1"
}
